root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# `dart format` hard-wraps at 80 and will not negotiate. Editors that soft-wrap
# elsewhere should agree here, or every save produces a formatting diff.
[*.dart]
max_line_length = 80

[*.{kt,kts,java}]
indent_size = 4

[*.swift]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
